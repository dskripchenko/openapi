{
  "name": "@dskripchenko/openapi",
  "version": "1.0.0",
  "description": "OpenAPI 2.0/3.0/3.1 in YAML or JSON with zero runtime dependencies — parse, validate, render with try-it and code samples, and edit visually (Vue components on @dskripchenko/ui)",
  "keywords": [
    "openapi",
    "swagger",
    "api-reference",
    "api-documentation",
    "yaml",
    "json-schema",
    "code-samples",
    "try-it",
    "vue",
    "zero-dependency"
  ],
  "homepage": "https://github.com/dskripchenko/openapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/openapi.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/openapi/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vue-tsc --noEmit -p tsconfig.vue.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs",
    "dev": "vite --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "@dskripchenko/ui": "^1.13.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@dskripchenko/ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dskripchenko/ui": "^1.13.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
